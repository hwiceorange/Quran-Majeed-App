<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <!-- Header -->
    <View
        android:id="@+id/headerBg"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_90"
        android:background="#5D9A7E"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:id="@+id/backBtn"
        android:layout_width="@dimen/dp_40"
        android:layout_height="@dimen/dp_40"
        android:layout_marginStart="@dimen/dp_16"
        android:layout_marginTop="@dimen/dp_40"
        android:src="@drawable/ic_arrow_back_white"
        android:contentDescription="Back"
        android:padding="@dimen/dp_8"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:ignore="HardcodedText" />

    <TextView
        android:id="@+id/headerTitleTv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/quiz_review_header"
        android:textColor="@android:color/white"
        android:textSize="@dimen/dp_20"
        android:fontFamily="sans-serif-medium"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/backBtn"
        app:layout_constraintBottom_toBottomOf="@id/backBtn" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@id/headerBg"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/dp_20">

            <!-- Title Section -->
            <TextView
                android:id="@+id/titleTv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/quiz_review_title"
                android:textColor="#1A1A1A"
                android:textSize="@dimen/dp_28"
                android:fontFamily="sans-serif-medium"
                android:layout_marginTop="@dimen/dp_16" />

            <TextView
                android:id="@+id/subtitleTv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/quiz_review_subtitle"
                android:textColor="#666666"
                android:textSize="@dimen/dp_14"
                android:fontFamily="sans-serif"
                android:layout_marginTop="@dimen/dp_4" />

            <!-- Correct Answer Card -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_24"
                app:cardCornerRadius="@dimen/dp_16"
                app:cardElevation="0dp"
                app:cardBackgroundColor="#E8F5E9">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="@dimen/dp_20"
                    android:gravity="start">

                    <View
                        android:layout_width="@dimen/dp_32"
                        android:layout_height="@dimen/dp_32"
                        android:background="@drawable/ic_check_circle"
                        android:layout_marginEnd="@dimen/dp_16" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/quiz_correct_answer_label"
                            android:textColor="#2E7D32"
                            android:textSize="@dimen/dp_13"
                            android:fontFamily="sans-serif-medium"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/correctAnswerTv"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Allah is the one and only God."
                            android:textColor="#1A1A1A"
                            android:textSize="@dimen/dp_15"
                            android:fontFamily="sans-serif"
                            android:layout_marginTop="@dimen/dp_6"
                            tools:ignore="HardcodedText" />
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Related Verse Card -->
            <androidx.cardview.widget.CardView
                android:id="@+id/relatedVerseCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_16"
                app:cardCornerRadius="@dimen/dp_16"
                app:cardElevation="0dp"
                app:cardBackgroundColor="#F8F9FA">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/dp_20">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/quiz_related_verse"
                        android:textColor="#5D9A7E"
                        android:textSize="@dimen/dp_13"
                        android:fontFamily="sans-serif-medium"
                        android:textStyle="bold"
                        tools:ignore="HardcodedText" />

                    <!-- Verse Reference (Surah:Ayah) -->
                    <TextView
                        android:id="@+id/verseReferenceTv"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Surah 1, Ayah 1"
                        android:textColor="#999999"
                        android:textSize="@dimen/dp_12"
                        android:fontFamily="sans-serif"
                        android:layout_marginTop="@dimen/dp_4"
                        android:visibility="gone"
                        tools:ignore="HardcodedText" />

                    <!-- Arabic Verse -->
                    <TextView
                        android:id="@+id/verseArabicTv"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="قُلْ هُوَ ٱللَّهُ أَحَدٌ"
                        android:textColor="#1A1A1A"
                        android:textSize="@dimen/dp_22"
                        android:fontFamily="sans-serif"
                        android:layout_marginTop="@dimen/dp_12"
                        android:gravity="end"
                        android:textDirection="rtl"
                        android:lineSpacingExtra="@dimen/dp_8"
                        tools:ignore="HardcodedText,RtlHardcoded" />

                    <!-- Translation -->
                    <TextView
                        android:id="@+id/verseTranslationTv"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Say, He is Allah, the One."
                        android:textColor="#666666"
                        android:textSize="@dimen/dp_15"
                        android:fontFamily="sans-serif"
                        android:layout_marginTop="@dimen/dp_12"
                        android:lineSpacingExtra="@dimen/dp_4"
                        tools:ignore="HardcodedText" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Simplified Tafsir Card -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_16"
                app:cardCornerRadius="@dimen/dp_12"
                app:cardElevation="@dimen/dp_2"
                app:cardBackgroundColor="#F5F5F5">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/dp_16">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/quiz_simplified_tafsir"
                        android:textColor="#5D9A7E"
                        android:textSize="@dimen/dp_12"
                        android:fontFamily="sans-serif-medium"
                        tools:ignore="HardcodedText" />

                    <TextView
                        android:id="@+id/tafsirBriefTv"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="This verse declares the absolute oneness of Allah, a core tenet of Islam. It emphasizes that He is unique, without partners or equals."
                        android:textColor="#666666"
                        android:textSize="@dimen/dp_14"
                        android:fontFamily="sans-serif"
                        android:lineSpacingExtra="@dimen/dp_4"
                        android:layout_marginTop="@dimen/dp_8"
                        tools:ignore="HardcodedText" />

                    <!-- Full Tafsir Link -->
                    <TextView
                        android:id="@+id/fullTafsirBtn"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/quiz_full_tafsir"
                        android:textColor="#5D9A7E"
                        android:textSize="@dimen/dp_14"
                        android:fontFamily="sans-serif-medium"
                        android:layout_marginTop="@dimen/dp_12"
                        android:paddingVertical="@dimen/dp_8"
                        android:drawableEnd="@drawable/ic_lock"
                        android:drawablePadding="@dimen/dp_8"
                        tools:ignore="HardcodedText" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Action Buttons：播放图标 + 文字 + AD 标识，一行内居中，RTL 安全不重叠 -->
            <FrameLayout
                android:id="@+id/tryAgainBtn"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp_52"
                android:layout_marginTop="@dimen/dp_24"
                android:background="@drawable/btn_quiz_green_primary"
                android:clickable="true"
                android:focusable="true">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="@dimen/dp_20"
                        android:layout_height="@dimen/dp_20"
                        android:layout_marginEnd="@dimen/dp_8"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_rewarded_video" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:text="@string/quiz_try_again_btn"
                        android:textColor="@android:color/white"
                        android:textSize="@dimen/dp_16"
                        tools:ignore="HardcodedText" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical|end"
                    android:layout_marginEnd="@dimen/dp_14"
                    android:background="@drawable/bg_ad_label"
                    android:paddingHorizontal="@dimen/dp_5"
                    android:paddingVertical="@dimen/dp_1"
                    android:text="@string/quran_gnt_ad"
                    android:textColor="#F2FFFFFF"
                    android:textSize="@dimen/dp_10" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/skipBtn"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp_52"
                android:layout_marginTop="@dimen/dp_12"
                android:background="@drawable/btn_quiz_green_secondary"
                android:clickable="true"
                android:focusable="true">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="@dimen/dp_20"
                        android:layout_height="@dimen/dp_20"
                        android:layout_marginEnd="@dimen/dp_8"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_rewarded_video" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:text="@string/quiz_skip_btn"
                        android:textColor="@android:color/white"
                        android:textSize="@dimen/dp_16"
                        tools:ignore="HardcodedText" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical|end"
                    android:layout_marginEnd="@dimen/dp_14"
                    android:background="@drawable/bg_ad_label"
                    android:paddingHorizontal="@dimen/dp_5"
                    android:paddingVertical="@dimen/dp_1"
                    android:text="@string/quran_gnt_ad"
                    android:textColor="#F2FFFFFF"
                    android:textSize="@dimen/dp_10" />
            </FrameLayout>

            <TextView
                android:id="@+id/quitBtn"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/dp_52"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="@dimen/dp_12"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:text="@string/quiz_quit_level_btn"
                android:textColor="#999999"
                android:textSize="@dimen/dp_16"
                android:paddingHorizontal="@dimen/dp_16"
                tools:ignore="HardcodedText" />

            <!-- Native Ad -->
            <com.quran.quranaudio.quiz.ad.AdNativeSmallWrapperView
                android:id="@+id/nativeAdView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_24"
                android:layout_marginBottom="@dimen/dp_20" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>

