<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_quiz">

    <!-- 里程碑图标：noor 光晕 + 敞开古兰经。固定尺寸置顶，下方元素依次排布不重叠 -->
    <FrameLayout
        android:id="@+id/levelThoughtLav"
        android:layout_width="210dp"
        android:layout_height="210dp"
        android:layout_marginTop="@dimen/dp_50"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/ic_quiz_noor_glow"
            android:importantForAccessibility="no" />

        <ImageView
            android:id="@+id/levelThoughtIcon"
            android:layout_width="150dp"
            android:layout_height="150dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_quiz_level_quran"
            android:importantForAccessibility="no" />
    </FrameLayout>

    <TextView
        android:id="@+id/levelPassTv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_4"
        android:fontFamily="@font/montserrat_bold"
        android:text="@string/quran_level_up"
        android:textColor="@color/white"
        android:textSize="@dimen/dp_24"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/levelThoughtLav" />

    <TextView
        android:id="@+id/levelPassSubtitleTv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_8"
        android:layout_marginHorizontal="@dimen/dp_32"
        android:fontFamily="@font/montserrat_semi_bold"
        android:gravity="center"
        android:text="@string/quran_level_up_subtitle"
        android:textColor="#CCFFFFFF"
        android:textSize="@dimen/dp_13"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/levelPassTv" />

    <!-- 连胜提示：仅连续通关 ≥2 关时显示(gone 时自动塌缩，下方按钮上移，无叠压) -->
    <TextView
        android:id="@+id/levelStreakTv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_12"
        android:background="@drawable/btn_levelup_reward_secondary"
        android:fontFamily="@font/montserrat_bold"
        android:paddingHorizontal="@dimen/dp_16"
        android:paddingVertical="@dimen/dp_6"
        android:textColor="#FFE9B0"
        android:textSize="@dimen/dp_13"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/levelPassSubtitleTv"
        tools:text="🔥 3 levels in a row, MashaAllah"
        tools:visibility="visible" />

    <!-- 次级操作：观看视频领奖励。图标+文字居中，AD 标识钉在按钮右侧边缘（垂直居中），RTL 下整体镜像不重叠。 -->
    <FrameLayout
        android:id="@+id/nextLevelAd"
        android:layout_width="0dp"
        android:layout_height="@dimen/dp_52"
        android:layout_marginHorizontal="@dimen/dp_20"
        android:layout_marginTop="@dimen/dp_28"
        android:background="@drawable/btn_levelup_reward_secondary"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/levelStreakTv">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="@dimen/dp_20"
                android:layout_height="@dimen/dp_20"
                android:layout_marginEnd="@dimen/dp_8"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_quiz_video_play" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/montserrat_semi_bold"
                android:text="@string/quran_reward"
                android:textColor="@color/white"
                android:textSize="@dimen/dp_16" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical|start"
            android:layout_marginStart="@dimen/dp_14"
            android:background="@drawable/bg_ad_label"
            android:paddingHorizontal="@dimen/dp_5"
            android:paddingVertical="@dimen/dp_1"
            android:text="@string/quran_gnt_ad"
            android:textColor="#F2FFFFFF"
            android:textSize="@dimen/dp_10" />
    </FrameLayout>

    <!-- +5 宝石徽章：贴在 Reward 按钮右上角，不再与文字叠压 -->
    <TextView
        android:id="@+id/next_level_reward"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/dp_24"
        app:drawableStartCompat="@drawable/bible_quiz_reward_gem_small"
        android:text="+5"
        android:textSize="@dimen/dp_16"
        android:drawablePadding="@dimen/dp_5"
        android:textColor="#FFE792"
        android:fontFamily="sans-serif-medium"
        android:gravity="center"
        android:background="@drawable/bg_quiz_watch_ad_gem"
        android:layout_marginEnd="@dimen/dp_12"
        android:paddingStart="@dimen/dp_7"
        android:paddingEnd="@dimen/dp_10"
        app:layout_constraintTop_toTopOf="@id/nextLevelAd"
        app:layout_constraintBottom_toTopOf="@id/nextLevelAd"
        app:layout_constraintEnd_toEndOf="@id/nextLevelAd" />

    <!-- 主操作：继续下一关 -->
    <TextView
        android:id="@+id/nextLevelTv"
        android:layout_width="0dp"
        android:layout_height="@dimen/dp_52"
        android:layout_marginHorizontal="@dimen/dp_20"
        android:layout_marginTop="@dimen/dp_20"
        android:background="@drawable/btn_levelup_continue_primary"
        android:fontFamily="@font/montserrat_bold"
        android:gravity="center"
        android:textColor="#1E7A54"
        android:textSize="@dimen/dp_18"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/nextLevelAd"
        tools:text="Level5" />

    <FrameLayout
        android:id="@+id/levelup_native_ad_container"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/dp_20"
        android:layout_marginTop="@dimen/dp_20"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/nextLevelTv" />

</androidx.constraintlayout.widget.ConstraintLayout>
