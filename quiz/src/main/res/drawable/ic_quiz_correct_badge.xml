<!-- 答对徽章：金环 + 白盘 + 绿勾。白=noor之光，绿=App主色，金环=庄重点缀。 -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="96dp"
    android:height="96dp"
    android:viewportWidth="96"
    android:viewportHeight="96">
