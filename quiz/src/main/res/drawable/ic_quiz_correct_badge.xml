    <path
        android:fillColor="#F4C95D"
        android:pathData="M48,48 m-46,0 a46,46 0 1,0 92,0 a46,46 0 1,0 -92,0 z" />
    <!-- 白色内盘 -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M48,48 m-41,0 a41,41 0 1,0 82,0 a41,41 0 1,0 -82,0 z" />
    <!-- 绿色对勾 -->
    <path
        android:strokeColor="#2E9E6B"
        android:strokeWidth="8"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M30,49 L43,63 L68,34" />
