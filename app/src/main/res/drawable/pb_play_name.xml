<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape android:shape="rectangle">
            <corners android:radius="5dp"/>
            <gradient android:startColor="@color/grey" android:endColor="@color/grey" android:angle="270"/>
        </shape>
    </item>
    <item android:id="@android:id/secondaryProgress">
        <clip>
            <shape android:shape="rectangle">
                <corners android:radius="5dp"/>
                <gradient android:startColor="#C4C4C4" android:endColor="#C4C4C4" android:angle="270"/>
            </shape>
        </clip>
    </item>
    <item android:id="@android:id/progress">
        <clip>
            <shape android:shape="rectangle">
                <corners android:radius="5dp"/>
                <gradient android:startColor="#F5AC1C" android:endColor="#F5AC1C" android:angle="270"/>
            </shape>
        </clip>
    </item>
</layer-list>
