<?xml version="1.0" encoding="utf-8"?>
<!-- 顶部图区底色。斜向渐变 + 上方叠加几何纹样，避免大面积纯色的廉价感。 -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <gradient
        android:angle="135"
        android:startColor="#2E7D5B"
        android:centerColor="#3E9B6E"
        android:endColor="#5BBF8C"
        android:type="linear" />
</shape>
