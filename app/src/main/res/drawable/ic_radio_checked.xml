<?xml version="1.0" encoding="utf-8"?>
<!-- 选中状态的单选按钮 - 标准样式：外圈+内圈小点 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 外圈 - 白色边框 -->
    <item>
        <shape android:shape="oval">
            <stroke
                android:width="2dp"
                android:color="#FFFFFF" />
            <solid android:color="#00000000" />
            <size
                android:width="24dp"
                android:height="24dp" />
        </shape>
    </item>
    <!-- 内部小圆点 - 白色填充 -->
    <item
        android:top="7dp"
        android:bottom="7dp"
        android:left="7dp"
        android:right="7dp">
        <shape android:shape="oval">
            <solid android:color="#FFFFFF" />
        </shape>
    </item>
</layer-list>

