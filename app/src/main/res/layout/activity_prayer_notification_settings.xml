<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/white"
    android:fitsSystemWindows="true">

    <!-- Toolbar with Back Arrow (完全复制Learning Plan Setup样式) -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="#4B9B76"
        android:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:titleTextColor="@android:color/white"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- ScrollView for content -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@id/toolbar"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Option: None -->
            <LinearLayout
                android:id="@+id/option_none"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="16dp"
                android:layout_marginBottom="12dp"
                android:background="@drawable/bg_notification_option_unselected"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:id="@+id/icon_none"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_notifications_off_24dp"
                    android:tint="#212121"
                    android:contentDescription="@string/content_desc_none" />

                <TextView
                    android:id="@+id/text_none"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="16dp"
                    android:text="@string/notification_type_none"
                    android:textColor="#212121"
                    android:textSize="16sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <!-- Option: Azan -->
            <LinearLayout
                android:id="@+id/option_azan"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="16dp"
                android:layout_marginBottom="12dp"
                android:background="@drawable/bg_notification_option_unselected"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:id="@+id/icon_azan"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_volume"
                    android:tint="#212121"
                    android:contentDescription="@string/content_desc_azan" />

                <TextView
                    android:id="@+id/text_azan"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="16dp"
                    android:text="@string/notification_type_azan"
                    android:textColor="#212121"
                    android:textSize="16sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <!-- Option: Vibrate -->
            <LinearLayout
                android:id="@+id/option_vibrate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="16dp"
                android:layout_marginBottom="12dp"
                android:background="@drawable/bg_notification_option_unselected"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:id="@+id/icon_vibrate"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_vibration"
                    android:tint="#212121"
                    android:contentDescription="@string/content_desc_vibrate" />

                <TextView
                    android:id="@+id/text_vibrate"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="16dp"
                    android:text="@string/notification_type_vibrate"
                    android:textColor="#212121"
                    android:textSize="16sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <!-- Option: Silent Notification -->
            <LinearLayout
                android:id="@+id/option_silent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="16dp"
                android:layout_marginBottom="12dp"
                android:background="@drawable/bg_notification_option_unselected"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:id="@+id/icon_silent"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_notifications_on_24dp"
                    android:tint="#212121"
                    android:contentDescription="@string/content_desc_silent" />

                <TextView
                    android:id="@+id/text_silent"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="16dp"
                    android:text="@string/notification_type_silent"
                    android:textColor="#212121"
                    android:textSize="16sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <!-- Option: Standard Text Tone -->
            <LinearLayout
                android:id="@+id/option_text_tone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="16dp"
                android:layout_marginBottom="12dp"
                android:background="@drawable/bg_notification_option_unselected"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:id="@+id/icon_text_tone"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_volume"
                    android:tint="#212121"
                    android:contentDescription="@string/content_desc_text_tone" />

                <TextView
                    android:id="@+id/text_text_tone"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="16dp"
                    android:text="@string/notification_type_text_tone"
                    android:textColor="#212121"
                    android:textSize="16sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <!-- Option: Clock sound -->
            <LinearLayout
                android:id="@+id/option_clock"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="16dp"
                android:layout_marginBottom="12dp"
                android:background="@drawable/bg_notification_option_unselected"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:id="@+id/icon_clock"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_alarm_clock"
                    android:tint="#212121"
                    android:contentDescription="@string/content_desc_clock" />

                <TextView
                    android:id="@+id/text_clock"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="16dp"
                    android:text="@string/notification_type_clock"
                    android:textColor="#212121"
                    android:textSize="16sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <!-- Expanded Options Container -->
            <LinearLayout
                android:id="@+id/expanded_options_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone"
                android:layout_marginTop="8dp"
                tools:visibility="visible">

                <!-- Azan Name (Only for Azan type) -->
                <LinearLayout
                    android:id="@+id/azan_name_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="16dp"
                    android:layout_marginBottom="12dp"
                    android:background="@drawable/rounded_background_light"
                    android:clickable="true"
                    android:focusable="true"
                    android:descendantFocusability="blocksDescendants"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/azan_name"
                        android:textColor="#212121"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:clickable="false"
                        android:focusable="false" />

                    <TextView
                        android:id="@+id/tv_azan_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/random_azan"
                        android:textColor="#757575"
                        android:textSize="14sp"
                        android:layout_marginEnd="8dp"
                        android:clickable="false"
                        android:focusable="false" />

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_right_arrow"
                        android:tint="#757575"
                        android:contentDescription="Arrow"
                        android:clickable="false"
                        android:focusable="false" />

                </LinearLayout>

                <!-- Notification Volume (Material Slider Style) -->
                <LinearLayout
                    android:id="@+id/volume_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:layout_marginBottom="12dp"
                    android:background="@drawable/rounded_background_light">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/notification_volume"
                        android:textColor="#212121"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="12dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0"
                            android:textColor="#757575"
                            android:textSize="14sp" />

                        <com.google.android.material.slider.Slider
                            android:id="@+id/volume_seekbar"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:valueFrom="0"
                            android:valueTo="100"
                            android:value="80"
                            android:stepSize="1"
                            app:thumbColor="#4B9B76"
                            app:trackColorActive="#4B9B76"
                            app:trackColorInactive="#E0E0E0" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="100"
                            android:textColor="#757575"
                            android:textSize="14sp" />

                    </LinearLayout>

                    <!-- Volume Value Display -->
                    <TextView
                        android:id="@+id/tv_volume_value"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/default_volume_display"
                        android:textColor="#212121"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:gravity="center"
                        android:layout_marginTop="8dp" />

                </LinearLayout>

                <!-- Pre-prayer Reminder -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:layout_marginBottom="12dp"
                    android:background="@drawable/rounded_background_light">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/pre_prayer_reminder"
                            android:textColor="#212121"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <com.google.android.material.switchmaterial.SwitchMaterial
                            android:id="@+id/switch_pre_reminder"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            app:thumbTint="@android:color/white"
                            app:trackTint="@color/switch_track_color" />

                    </LinearLayout>

                    <!-- Minutes selector (shown when switch is ON) -->
                    <LinearLayout
                        android:id="@+id/minutes_selector_container"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="16dp"
                        android:visibility="gone"
                        tools:visibility="visible">

                        <TextView
                            android:id="@+id/tv_minutes_value"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/default_minutes_display"
                            android:textColor="#212121"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center">

                            <ImageView
                                android:id="@+id/btn_minutes_decrease"
                                android:layout_width="48dp"
                                android:layout_height="48dp"
                                android:src="@drawable/ic_arrow_back"
                                android:rotation="180"
                                android:padding="12dp"
                                android:background="@android:color/transparent"
                                android:contentDescription="@string/content_desc_decrease"
                                android:tint="#4B9B76" />

                            <ImageView
                                android:id="@+id/btn_minutes_increase"
                                android:layout_width="48dp"
                                android:layout_height="48dp"
                                android:src="@drawable/ic_arrow_back"
                                android:padding="12dp"
                                android:background="@android:color/transparent"
                                android:contentDescription="@string/content_desc_increase"
                                android:tint="#4B9B76" />

                        </LinearLayout>

                    </LinearLayout>

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
