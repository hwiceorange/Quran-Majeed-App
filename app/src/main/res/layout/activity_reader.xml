<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".quran_module.activities.ActivityReader">

   <com.quran.quranaudio.online.quran_module.views.reader.ReaderHeader
        android:id="@+id/readerHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />


    <me.dkzwm.widget.srl.SmoothRefreshLayout
        android:id="@+id/swipeLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior"
        app:sr_enableLoadMore="true"
        app:sr_enablePullToRefresh="true"
        app:sr_maxMoveRatio="1.5"
        app:sr_ratioToRefresh="2"
        app:sr_resistance="4">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/readerVerses"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:overScrollMode="never"
            android:paddingTop="5dp"
            android:paddingBottom="@dimen/dmnPadMassive" />
    </me.dkzwm.widget.srl.SmoothRefreshLayout>

    <LinearLayout
        android:id="@+id/floatingFooter"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal|bottom"
        android:animateLayoutChanges="true"
        android:orientation="vertical"
        app:layout_behavior="@string/hide_bottom_view_on_scroll_behavior">

       <com.quran.quranaudio.online.quran_module.views.reader.VerseQuickActionsView
            android:id="@+id/verseQuickActions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone"
            tools:visibility="visible" />

        <View
            android:id="@+id/navigationBarDummy"
            android:layout_width="match_parent"
            android:layout_height="0dp" />
    </LinearLayout>

    <!-- 情境化"本章测验"入口浮层：默认隐藏，仅当本章题量足够时显示（ActivityReader 中控制）。纯增量，不影响任何现有视图。 -->
    <TextView
        android:id="@+id/btnSurahQuizEntry"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="210dp"
        android:background="@drawable/bg_surah_quiz_pill"
        android:drawablePadding="6dp"
        android:elevation="8dp"
        android:fontFamily="sans-serif-medium"
        android:paddingHorizontal="18dp"
        android:paddingVertical="10dp"
        android:text="@string/quiz_surah_test_btn"
        android:textColor="@android:color/white"
        android:textSize="14sp"
        android:visibility="gone" />
</androidx.coordinatorlayout.widget.CoordinatorLayout>