<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <!-- 品牌绿渐变背景 -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_subscription_gradient" />

    <!-- 顶部清真寺剪影（低透明度，仅作氛围） -->
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="200dp"
        android:layout_gravity="top"
        android:scaleType="centerCrop"
        android:src="@drawable/ic_junaid"
        android:alpha="0.35"
        android:contentDescription="@string/app_name" />

    <!-- 关闭按钮：首帧即可见可点 -->
    <ImageView
        android:id="@+id/btn_close"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_gravity="top|start"
        android:layout_margin="10dp"
        android:padding="11dp"
        android:src="@drawable/dr_icon_close"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/strLabelClose"
        app:tint="@android:color/white"
        android:elevation="10dp" />

    <!-- 核心内容：垂直居中，聚焦折扣 + 倒计时 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingStart="28dp"
        android:paddingEnd="28dp">

        <!-- 限时药丸：框定「限时领取」语义（与计费期彻底分开，避免歧义） -->
        <TextView
            android:id="@+id/tv_limited_pill"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_discount_pill"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:text="@string/discount_limited_pill"
            android:textColor="#1B5E20"
            android:textSize="14sp"
            android:textStyle="bold"
            android:letterSpacing="0.02"
            android:gravity="center" />

        <!-- 主角 1：折扣百分比（超大） -->
        <TextView
            android:id="@+id/tv_discount_percent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/discount_percent_placeholder"
            android:textColor="#FFD54F"
            android:textSize="88sp"
            android:textStyle="bold"
            android:includeFontPadding="false"
            android:letterSpacing="-0.02"
            android:gravity="center"
            tools:text="50% OFF" />

        <!-- 优惠范围（首月/首年）：明确优惠仅限首期 -->
        <TextView
            android:id="@+id/tv_discount_caption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/discount_first_year_caption"
            android:textColor="#EAF3EE"
            android:textSize="16sp"
            android:letterSpacing="0.02"
            android:gravity="center" />

        <!-- 价值/情感锚定（精神共鸣，竞品给不了的差异化） -->
        <TextView
            android:id="@+id/tv_discount_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/discount_title"
            android:textColor="#D6E6DB"
            android:textSize="16sp"
            android:gravity="center" />

        <!-- 主角 2：倒计时数字卡（分段，从容不焦虑） -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tv_countdown_min"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="92dp"
                android:background="@drawable/bg_countdown_card"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:text="60"
                android:textColor="#14543F"
                android:textSize="48sp"
                android:textStyle="bold"
                android:fontFeatureSettings="tnum"
                android:includeFontPadding="false"
                android:gravity="center"
                android:elevation="3dp"
                tools:text="59" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="10dp"
                android:text=":"
                android:textColor="@android:color/white"
                android:textSize="40sp"
                android:textStyle="bold"
                android:includeFontPadding="false" />

            <TextView
                android:id="@+id/tv_countdown_sec"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="92dp"
                android:background="@drawable/bg_countdown_card"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:text="00"
                android:textColor="#14543F"
                android:textSize="48sp"
                android:textStyle="bold"
                android:fontFeatureSettings="tnum"
                android:includeFontPadding="false"
                android:gravity="center"
                android:elevation="3dp"
                tools:text="55" />
        </LinearLayout>

        <!-- 价格：紧凑一行，划线原价 + 折后价 -->
        <LinearLayout
            android:id="@+id/price_row"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tv_original_price"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="10dp"
                android:textColor="#A9C0B2"
                android:textSize="18sp"
                tools:text="HK$78.00" />

            <TextView
                android:id="@+id/tv_discounted_price"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@android:color/white"
                android:textSize="26sp"
                android:textStyle="bold"
                tools:text="HK$39.00" />

            <TextView
                android:id="@+id/tv_price_period"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="@string/discount_price_period"
                android:textColor="#C9DBCF"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- 合规：优惠结束后的原价 + 取消方式，醒目展示（不埋进小字披露） -->
        <TextView
            android:id="@+id/tv_then_price"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:gravity="center"
            tools:text="Then HK$78.00/year after · Cancel anytime" />

        <!-- 主 CTA：金色、满宽、醒目 -->
        <TextView
            android:id="@+id/btn_subscribe"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:background="@drawable/bg_subscription_button"
            android:paddingTop="18dp"
            android:paddingBottom="18dp"
            android:text="@string/discount_cta"
            android:textColor="#1A1A1A"
            android:textSize="18sp"
            android:textStyle="bold"
            android:gravity="center"
            android:elevation="2dp" />

    </LinearLayout>

    <!-- 底部合规区：续订披露 + 法务链接（精简、贴底） -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingStart="26dp"
        android:paddingEnd="26dp"
        android:paddingBottom="14dp">

        <TextView
            android:id="@+id/tv_disclosure"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#ECF3EE"
            android:textSize="12sp"
            android:gravity="center"
            android:lineSpacingExtra="2dp" />

        <TextView
            android:id="@+id/tv_legal_links"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/subscription_legal_links"
            android:textColor="#F3D680"
            android:textSize="12sp"
            android:textStyle="bold"
            android:gravity="center" />
    </LinearLayout>

</FrameLayout>
