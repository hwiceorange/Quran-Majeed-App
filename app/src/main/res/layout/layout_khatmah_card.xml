<?xml version="1.0" encoding="utf-8"?>
<!--
    Khatmah(通读)计划卡片。两个状态由 HomeFragment 控制：
    - 无计划：显示"开始 30 天读完古兰经" CTA(khatmah_cta_group)
    - 有计划：显示第几天/30、已读 Juz、进度条、领先/落后状态(khatmah_active_group)
-->
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/khatmah_card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="16dp"
    android:layout_marginEnd="16dp"
    android:layout_marginTop="12dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="3dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#0F4E8545"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="14dp"
        android:paddingBottom="14dp">

        <!-- 顶行：标题 + 天数/状态 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/khatmah_title"
                android:textColor="#4E8545"
                android:textSize="13sp"
                android:textAllCaps="true"
                android:textStyle="bold"
                android:letterSpacing="0.03" />

            <TextView
                android:id="@+id/tv_khatmah_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="12sp"
                android:textStyle="bold"
                tools:text="On track" />
        </LinearLayout>

        <!-- 无计划：CTA -->
        <TextView
            android:id="@+id/khatmah_cta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/khatmah_start_cta"
            android:textColor="#2D3A53"
            android:textSize="15sp"
            android:textStyle="bold"
            android:visibility="gone"
            tools:visibility="visible" />

        <!-- 有计划：进度 -->
        <LinearLayout
            android:id="@+id/khatmah_active_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            tools:visibility="visible">

            <TextView
                android:id="@+id/tv_khatmah_day"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textColor="#2D3A53"
                android:textSize="15sp"
                android:textStyle="bold"
                tools:text="Day 5 of 30 · Juz 5 / 30" />

            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:id="@+id/khatmah_progress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:max="30"
                app:indicatorColor="#4E8545"
                app:trackColor="#264E8545"
                app:trackCornerRadius="4dp"
                app:trackThickness="6dp" />
        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>
