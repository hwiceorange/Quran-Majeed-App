<?xml version="1.0" encoding="utf-8"?>
<!--
    经文注释内容锁定层(重构版)
    设计原则(古兰经 App，尊重神圣感、克制不侵略)：
    - 底部贴合卡片，高度随内容自适应(消除旧版固定 50% 高度导致的元素重叠)
    - 上方渐隐遮罩暗示"下方还有内容"，引导解锁
    - 清晰层级：锁图标 → 标题 → 描述 → 免费(看广告) → 或 → 订阅
    - 全 start/end，RTL(阿拉伯语/乌尔都语)自动镜像；文案全部走多语言资源
-->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/contentLockOverlay"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layoutDirection="locale"
    android:visibility="gone"
    tools:visibility="visible">

    <!-- 上方渐隐遮罩：暗示下方有更多内容 -->
    <View
        android:id="@+id/lockFadeMask"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:background="@drawable/bg_content_lock_gradient"
        app:layout_constraintBottom_toTopOf="@id/lockCard"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- 底部卡片：随内容自适应高度 -->
    <LinearLayout
        android:id="@+id/lockCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/BlackWhite"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="20dp"
        android:paddingBottom="28dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:contentDescription="@string/content_locked"
            android:src="@drawable/ic_lock"
            app:tint="@color/colorPrimary" />

        <TextView
            android:id="@+id/tvLockTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/unlock_full_content"
            android:textAlignment="center"
            android:textColor="@color/colorText"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvLockDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/unlock_description"
            android:textAlignment="center"
            android:textColor="@color/colorText2"
            android:textSize="13sp" />

        <!-- 免费解锁(主选项：这些市场对小额付费意愿低，看广告解锁转化更好) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnWatchAd"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="20dp"
            android:text="@string/watch_ad_to_unlock"
            android:textAllCaps="false"
            android:textSize="15sp"
            app:cornerRadius="12dp"
            app:icon="@drawable/ic_play_circle"
            app:iconGravity="textStart"
            app:iconPadding="8dp"
            app:iconTint="@color/white" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="10dp"
            android:text="@string/or"
            android:textAllCaps="true"
            android:textColor="@color/colorText2"
            android:textSize="12sp"
            android:letterSpacing="0.06" />

        <!-- 永久解锁(订阅) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSubscribe"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="@string/subscribe_to_unlock"
            android:textAllCaps="false"
            android:textColor="@color/colorPrimary"
            android:textSize="15sp"
            app:cornerRadius="12dp"
            app:icon="@drawable/ic_star"
            app:iconGravity="textStart"
            app:iconPadding="8dp"
            app:iconTint="@color/colorPrimary"
            app:strokeColor="@color/colorPrimary"
            app:strokeWidth="1dp" />
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
