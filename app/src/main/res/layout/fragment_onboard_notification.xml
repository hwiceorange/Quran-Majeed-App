<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#429971">

    <!-- 标题 -->
    <TextView
        android:id="@+id/tv_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="32dp"
        android:layout_marginTop="60dp"
        android:layout_marginEnd="32dp"
        android:text="@string/onboard_notification_title"
        android:textAlignment="center"
        android:textColor="@android:color/white"
        android:textSize="32sp"
        android:textStyle="bold"
        android:fontFamily="sans-serif-medium"
        android:lineSpacingExtra="4dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- 副标题 -->
    <TextView
        android:id="@+id/tv_subtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="32dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="32dp"
        android:text="@string/onboard_notification_subtitle"
        android:textAlignment="center"
        android:textColor="#E0FFFFFF"
        android:textSize="15sp"
        android:fontFamily="sans-serif"
        android:lineSpacingExtra="2dp"
        app:layout_constraintTop_toBottomOf="@id/tv_title"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- 通知权限卡片（模仿系统通知样式） -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_notification"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="32dp"
        android:layout_marginTop="60dp"
        android:layout_marginEnd="32dp"
        app:cardBackgroundColor="#8F9395"
        app:cardCornerRadius="16dp"
        app:cardElevation="8dp"
        app:layout_constraintTop_toBottomOf="@id/tv_subtitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- 通知标题 -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/onboard_notification_dialog_title"
                android:textAlignment="center"
                android:textColor="@android:color/white"
                android:textSize="18sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-medium"
                android:lineSpacingExtra="2dp"
                android:layout_marginBottom="16dp" />

            <!-- 通知说明 -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/onboard_notification_dialog_desc"
                android:textAlignment="center"
                android:textColor="#B3FFFFFF"
                android:textSize="14sp"
                android:fontFamily="sans-serif"
                android:lineSpacingExtra="2dp"
                android:layout_marginBottom="24dp" />

            <!-- Allow 按钮 -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_allow"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="@string/onboard_notification_allow"
                android:textColor="#304465"
                android:textSize="16sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-medium"
                app:backgroundTint="#B4C8E8"
                app:cornerRadius="8dp"
                android:stateListAnimator="@null"
                android:layout_marginBottom="12dp" />

            <!-- Don't allow 按钮 -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_dont_allow"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="@string/onboard_notification_dont_allow"
                android:textColor="#304465"
                android:textSize="16sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-medium"
                app:backgroundTint="#B4C8E8"
                app:cornerRadius="8dp"
                android:stateListAnimator="@null" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- 小手指图标（悬浮在Allow按钮上，手指指向按钮中心） -->
    <ImageView
        android:id="@+id/icon_hand_pointer"
        android:layout_width="70dp"
        android:layout_height="70dp"
        android:src="@drawable/ic_hand"
        android:contentDescription="Tap here"
        android:elevation="10dp"
        app:layout_constraintEnd_toEndOf="@id/card_notification"
        app:layout_constraintTop_toTopOf="@id/card_notification"
        android:layout_marginEnd="20dp"
        android:layout_marginTop="200dp" />

    <!-- 底部用户评价卡片 -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_review"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="32dp"
        android:layout_marginEnd="32dp"
        android:layout_marginBottom="32dp"
        app:cardBackgroundColor="#357A5E"
        app:cardCornerRadius="16dp"
        app:cardElevation="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="20dp"
            android:gravity="center_vertical">

            <!-- 评价文字 -->
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/onboard_notification_review"
                android:textColor="@android:color/white"
                android:textSize="13sp"
                android:fontFamily="sans-serif"
                android:lineSpacingExtra="2dp"
                android:textStyle="italic"
                android:layout_marginEnd="12dp" />

            <!-- 用户信息 -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="end">

                <!-- 用户头像：名字首字母 + 彩色圆圈(Google Play 风格，真实评论无需照片) -->
                <TextView
                    android:id="@+id/img_user_avatar"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:gravity="center"
                    android:layout_gravity="center_horizontal"
                    android:background="@drawable/circle_background"
                    android:textColor="@android:color/white"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="4dp"
                    tools:text="M" />

                <!-- 用户名 -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/onboard_notification_review_name"
                    android:textColor="#E0FFFFFF"
                    android:textSize="11sp"
                    android:fontFamily="sans-serif" />

                <!-- Verified User -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/onboard_notification_review_verified"
                    android:textColor="#B3FFFFFF"
                    android:textSize="10sp"
                    android:fontFamily="sans-serif" />
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>

