<?xml version="1.0" encoding="utf-8"?>
<!-- 祷告记录 Bottom Sheet -->
<androidx.constraintlayout.widget.ConstraintLayout 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet"
    android:padding="24dp">

    <!-- 顶部拖动条 -->
    <View
        android:id="@+id/drag_handle"
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_drag_handle"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- 标题: Log Prayer -->
    <TextView
        android:id="@+id/tv_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="Log Prayer"
        android:textColor="@color/prayer_modal_accent"
        android:textSize="22sp"
        android:textStyle="bold"
        android:fontFamily="sans-serif-medium"
        app:layout_constraintTop_toBottomOf="@id/drag_handle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- 祷告名称区域 -->
    <TextView
        android:id="@+id/tv_prayer_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="Prayer"
        android:textColor="@color/prayer_modal_text_secondary"
        android:textSize="15sp"
        android:fontFamily="sans-serif"
        app:layout_constraintTop_toBottomOf="@id/tv_title"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/tv_prayer_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Asr"
        android:textColor="@color/prayer_modal_text_primary"
        android:textSize="16sp"
        android:textStyle="bold"
        android:fontFamily="sans-serif-medium"
        app:layout_constraintTop_toTopOf="@id/tv_prayer_label"
        app:layout_constraintBottom_toBottomOf="@id/tv_prayer_label"
        app:layout_constraintEnd_toEndOf="parent"
        tools:text="Asr" />

    <!-- Status 标签 -->
    <TextView
        android:id="@+id/tv_status_label"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="Status"
        android:textColor="@color/prayer_modal_text_primary"
        android:textSize="16sp"
        android:textStyle="bold"
        android:fontFamily="sans-serif-medium"
        app:layout_constraintTop_toBottomOf="@id/tv_prayer_label"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Segmented Control for Status -->
    <LinearLayout
        android:id="@+id/status_selector"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal"
        android:baselineAligned="false"
        android:weightSum="3"
        android:background="@drawable/bg_segmented_control_container"
        android:padding="4dp"
        app:layout_constraintTop_toBottomOf="@id/tv_status_label"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Ada' (已完成) -->
        <TextView
            android:id="@+id/btn_status_ada"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:text="Ada'"
            android:textColor="@color/selector_status_text_color"
            android:textSize="15sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:background="@drawable/selector_status_button"
            android:clickable="true"
            android:focusable="true"
            android:tag="ada" />

        <!-- Qada' (弥补) -->
        <TextView
            android:id="@+id/btn_status_qada"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"
            android:text="Qada'"
            android:textColor="@color/selector_status_text_color"
            android:textSize="15sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:background="@drawable/selector_status_button"
            android:clickable="true"
            android:focusable="true"
            android:tag="qada" />

        <!-- Missed (错过) -->
        <TextView
            android:id="@+id/btn_status_missed"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:text="Missed"
            android:textColor="@color/selector_status_text_color"
            android:textSize="15sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:background="@drawable/selector_status_button"
            android:clickable="true"
            android:focusable="true"
            android:tag="missed" />
    </LinearLayout>

    <!-- Prayed At (实际祷告时间) -->
    <ImageView
        android:id="@+id/icon_time"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginTop="24dp"
        android:src="@drawable/ic_time"
        app:tint="@color/prayer_modal_text_secondary"
        android:contentDescription="@null"
        app:layout_constraintTop_toBottomOf="@id/status_selector"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/tv_prayed_at_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:text="Prayed At"
        android:textColor="@color/prayer_modal_text_secondary"
        android:textSize="15sp"
        android:fontFamily="sans-serif"
        app:layout_constraintTop_toTopOf="@id/icon_time"
        app:layout_constraintBottom_toBottomOf="@id/icon_time"
        app:layout_constraintStart_toEndOf="@id/icon_time" />

    <LinearLayout
        android:id="@+id/container_prayed_at"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        app:layout_constraintTop_toTopOf="@id/icon_time"
        app:layout_constraintBottom_toBottomOf="@id/icon_time"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/tv_prayed_at_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="4:30 PM"
        android:textColor="@color/prayer_modal_accent"
            android:textSize="16sp"
            android:textStyle="bold"
        android:fontFamily="sans-serif-medium"
            tools:text="4:30 PM" />

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginStart="4dp"
            android:src="@drawable/ic_arrow_down"
            app:tint="#757575"
            android:contentDescription="@null" />
    </LinearLayout>

    <!-- Recorded At (记录时间) -->
    <ImageView
        android:id="@+id/icon_recorded"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginTop="16dp"
        android:src="@drawable/ic_refresh"
        app:tint="@color/prayer_modal_text_secondary"
        android:contentDescription="@null"
        app:layout_constraintTop_toBottomOf="@id/icon_time"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/tv_recorded_at_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:text="Recorded At"
        android:textColor="@color/prayer_modal_text_secondary"
        android:textSize="15sp"
        android:fontFamily="sans-serif"
        app:layout_constraintTop_toTopOf="@id/icon_recorded"
        app:layout_constraintBottom_toBottomOf="@id/icon_recorded"
        app:layout_constraintStart_toEndOf="@id/icon_recorded" />

    <TextView
        android:id="@+id/tv_recorded_at_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="11:30 AM (UTC)"
        android:textColor="@color/prayer_modal_text_secondary"
        android:textSize="15sp"
        android:fontFamily="sans-serif"
        app:layout_constraintTop_toTopOf="@id/icon_recorded"
        app:layout_constraintBottom_toBottomOf="@id/icon_recorded"
        app:layout_constraintEnd_toEndOf="parent"
        tools:text="11:30 AM (UTC)" />

    <!-- Notes 标签 -->
    <TextView
        android:id="@+id/tv_notes_label"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="Notes"
        android:textColor="@color/prayer_modal_text_primary"
        android:textSize="16sp"
        android:textStyle="bold"
        android:fontFamily="sans-serif-medium"
        app:layout_constraintTop_toBottomOf="@id/icon_recorded"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- 常用标签 (Tags) -->
    <com.google.android.material.chip.ChipGroup
        android:id="@+id/chip_group_tags"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        app:chipSpacingHorizontal="8dp"
        app:singleLine="false"
        app:singleSelection="false"
        app:selectionRequired="false"
        android:clickable="false"
        android:focusable="false"
        app:layout_constraintTop_toBottomOf="@id/tv_notes_label"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.google.android.material.chip.Chip
            android:id="@+id/chip_mosque"
            style="@style/Widget.MaterialComponents.Chip.Choice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="+ At Mosque"
            android:textColor="@color/prayer_modal_text_secondary"
            android:textSize="13sp"
            android:clickable="true"
            android:focusable="true"
            android:checkable="true"
            app:chipBackgroundColor="@color/prayer_modal_accent_light"
            app:chipStrokeWidth="0dp"
            app:chipCornerRadius="16dp"
            app:ensureMinTouchTargetSize="true" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chip_traveling"
            style="@style/Widget.MaterialComponents.Chip.Choice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="+ Traveling"
            android:textColor="@color/prayer_modal_text_secondary"
            android:textSize="13sp"
            android:clickable="true"
            android:focusable="true"
            android:checkable="true"
            app:chipBackgroundColor="@color/prayer_modal_accent_light"
            app:chipStrokeWidth="0dp"
            app:chipCornerRadius="16dp"
            app:ensureMinTouchTargetSize="true" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chip_family"
            style="@style/Widget.MaterialComponents.Chip.Choice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="+ With Family"
            android:textColor="@color/prayer_modal_text_secondary"
            android:textSize="13sp"
            android:clickable="true"
            android:focusable="true"
            android:checkable="true"
            app:chipBackgroundColor="@color/prayer_modal_accent_light"
            app:chipStrokeWidth="0dp"
            app:chipCornerRadius="16dp"
            app:ensureMinTouchTargetSize="true" />
    </com.google.android.material.chip.ChipGroup>

    <!-- 备注输入框 -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/input_layout_notes"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:hint="Add any details..."
        app:boxBackgroundMode="outline"
        app:boxCornerRadiusTopStart="12dp"
        app:boxCornerRadiusTopEnd="12dp"
        app:boxCornerRadiusBottomStart="12dp"
        app:boxCornerRadiusBottomEnd="12dp"
        app:boxStrokeColor="@color/prayer_modal_accent"
        app:hintTextColor="@color/prayer_modal_text_secondary"
        app:layout_constraintTop_toBottomOf="@id/chip_group_tags"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/et_notes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="80dp"
            android:gravity="top|start"
            android:inputType="textMultiLine|textCapSentences"
            android:maxLength="100"
            android:textColor="@color/prayer_modal_text_primary"
            android:textSize="15sp"
            android:padding="12dp" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- 按钮组 -->
    <LinearLayout
        android:id="@+id/button_container"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:orientation="horizontal"
        android:weightSum="2"
        app:layout_constraintTop_toBottomOf="@id/input_layout_notes"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <!-- Cancel 按钮 -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_cancel"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:text="Cancel"
            android:textColor="@color/prayer_modal_accent"
            android:textSize="16sp"
            android:textStyle="bold"
            app:backgroundTint="@color/prayer_modal_accent_light"
            app:strokeColor="@color/prayer_modal_accent"
            app:strokeWidth="1dp"
            app:cornerRadius="12dp"
            android:elevation="0dp"
            app:rippleColor="@color/prayer_modal_accent" />

        <!-- Save 按钮 -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_save"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="Save"
            android:textColor="@android:color/white"
            android:textSize="16sp"
            android:textStyle="bold"
            app:backgroundTint="@color/prayer_modal_accent"
            app:cornerRadius="12dp"
            android:elevation="2dp"
            app:rippleColor="@color/prayer_modal_accent_light" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>

