<?xml version="1.0" encoding="utf-8"?>
<!--
  去广告弹窗（一次性买断 removeads）。严格对齐参考卡片的版式比例：

    ┌──────────────────────────┐  ← 四角全圆、四边留白，卡片「浮起」
    │      图区（含关闭 X）      │  ← 约占卡片高度 45%
    ├──────────────────────────┤
    │ ◆ 徽标（强调色，小字）      │
    │ 粗标题                     │
    │ 灰色说明（1~3 行）          │
    │ ┌──────────────────────┐  │
    │ │      胶囊主按钮        │  │  ← 整宽、圆角 = 高度一半
    │ └──────────────────────┘  │
    │        次要文字链           │
    └──────────────────────────┘

  上一版丑在三点，这里逐一修正：
    1. 卡片满宽贴边 → 改用 MaterialCardView + 外边距，四角统一 24dp 圆角，
       并靠 cardCornerRadius 真正裁切图区（原来靠背景 shape，图区盖住了圆角）；
    2. 图区是 150dp 纯色 + 小图标，大片空白显廉价 → 换成斜向渐变
       + 八角星（Rub el Hizb）几何纹样，并降到 168dp、加一层低透明度重复母题做层次；
    3. 关闭键是裸图标，在色块上几乎看不见 → 加半透明圆底，与参考图一致。

  阿语（RTL）：
    - 一律用 Start/End，不用 Left/Right；关闭键 constraintEnd → RTL 下自动翻到左上角；
    - 文本 textAlignment="viewStart" 跟随书写方向；
    - 徽标行为 horizontal LinearLayout，RTL 下系统自动反转图标与文字顺序。
    manifest 已声明 android:supportsRtl="true"。
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="20dp"
    android:paddingEnd="20dp">

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="24dp"
        app:cardElevation="12dp"
        app:cardBackgroundColor="?android:attr/colorBackground">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- ===== 图区 ===== -->
            <View
                android:id="@+id/adFreeBanner"
                android:layout_width="0dp"
                android:layout_height="168dp"
                android:background="@drawable/bg_ad_free_banner"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- 背景层：大号纹样低透明度外溢，制造纵深，避免纯色块的空洞感 -->
            <ImageView
                android:layout_width="220dp"
                android:layout_height="220dp"
                android:alpha="0.10"
                android:contentDescription="@null"
                android:src="@drawable/ic_ad_free_star"
                app:layout_constraintTop_toTopOf="@id/adFreeBanner"
                app:layout_constraintBottom_toBottomOf="@id/adFreeBanner"
                app:layout_constraintStart_toStartOf="@id/adFreeBanner"
                app:layout_constraintHorizontal_bias="0.05" />

            <!-- 主体纹样 -->
            <ImageView
                android:layout_width="92dp"
                android:layout_height="92dp"
                android:alpha="0.95"
                android:contentDescription="@null"
                android:src="@drawable/ic_ad_free_star"
                app:layout_constraintTop_toTopOf="@id/adFreeBanner"
                app:layout_constraintBottom_toBottomOf="@id/adFreeBanner"
                app:layout_constraintStart_toStartOf="@id/adFreeBanner"
                app:layout_constraintEnd_toEndOf="@id/adFreeBanner" />

            <!-- 关闭：半透明圆底，RTL 下自动移到左上角 -->
            <ImageView
                android:id="@+id/adFreeClose"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_marginTop="14dp"
                android:layout_marginEnd="14dp"
                android:background="@drawable/bg_ad_free_close"
                android:contentDescription="@string/ad_free_close"
                android:padding="6dp"
                android:src="@drawable/ic_close_24dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:tint="#FFFFFF" />

            <!-- ===== 文案区 ===== -->
            <LinearLayout
                android:id="@+id/adFreeBadgeRow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="22dp"
                android:layout_marginTop="20dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/adFreeBanner">

                <ImageView
                    android:layout_width="15dp"
                    android:layout_height="15dp"
                    android:layout_marginEnd="6dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_premium"
                    app:tint="#2E7D5B" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.02"
                    android:text="@string/ad_free_badge"
                    android:textAllCaps="false"
                    android:textColor="#2E7D5B"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/adFreeTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="22dp"
                android:layout_marginTop="6dp"
                android:layout_marginEnd="22dp"
                android:lineSpacingExtra="2dp"
                android:text="@string/ad_free_title"
                android:textAlignment="viewStart"
                android:textColor="?android:attr/textColorPrimary"
                android:textSize="22sp"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/adFreeBadgeRow" />

            <TextView
                android:id="@+id/adFreeBody"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="22dp"
                android:layout_marginTop="10dp"
                android:layout_marginEnd="22dp"
                android:lineSpacingExtra="4dp"
                android:text="@string/ad_free_body"
                android:textAlignment="viewStart"
                android:textColor="?android:attr/textColorSecondary"
                android:textSize="14sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/adFreeTitle" />

            <TextView
                android:id="@+id/adFreeCta"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_marginStart="22dp"
                android:layout_marginTop="22dp"
                android:layout_marginEnd="22dp"
                android:background="@drawable/bg_ad_free_cta"
                android:foreground="?attr/selectableItemBackground"
                android:gravity="center"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="@string/ad_free_cta"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/adFreeBody" />

            <TextView
                android:id="@+id/adFreeRewardHour"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginStart="22dp"
                android:layout_marginTop="10dp"
                android:layout_marginEnd="22dp"
                android:background="?attr/selectableItemBackground"
                android:gravity="center"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="@string/quiet_reading_one_hour"
                android:textColor="#2E7D5B"
                android:textSize="15sp"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/adFreeCta" />

            <!-- 恢复购买：换机/重装的已付费用户必须有入口，否则会重复付费或给差评 -->
            <TextView
                android:id="@+id/adFreeRestore"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="16dp"
                android:background="?attr/selectableItemBackground"
                android:padding="10dp"
                android:text="@string/ad_free_restore"
                android:textColor="?android:attr/textColorSecondary"
                android:textSize="13sp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/adFreeRewardHour" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.google.android.material.card.MaterialCardView>
</FrameLayout>
