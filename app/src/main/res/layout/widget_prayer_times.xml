<?xml version="1.0" encoding="utf-8"?>
<!--
    祈祷时间桌面 Widget（4x1）
    第一行：下一番祈祷名 + 倒计时（Chronometer, countDown）+ Hijri 日期
    第二行：五番名称 + 时间，当前"下一番"列高亮
    仅使用 RemoteViews 支持的控件（LinearLayout/TextView/Chronometer）；
    统一使用 start/end 与 gravity=center，RTL（阿拉伯语/乌尔都语）自动镜像。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_prayer_bg"
    android:orientation="vertical"
    android:paddingStart="10dp"
    android:paddingEnd="10dp"
    android:paddingTop="6dp"
    android:paddingBottom="6dp">

    <!-- 空状态：尚无祈祷数据（用户还没打开过 App 完成定位） -->
    <TextView
        android:id="@+id/widget_empty_state"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:text="@string/widget_tap_to_setup"
        android:textColor="@color/widget_prayer_text_primary"
        android:textSize="13sp"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/widget_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- 头部：下一番 + 倒计时 + Hijri 日期 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/widget_next_prayer_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/widget_prayer_accent"
                android:textSize="12sp"
                android:textStyle="bold" />

            <Chronometer
                android:id="@+id/widget_countdown"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:countDown="true"
                android:textColor="@color/widget_prayer_accent"
                android:textSize="12sp"
                android:textStyle="bold" />

            <!-- RemoteViews 不支持裸 View 作 spacer，用 weight+gravity 的 TextView 自身实现右对齐 -->
            <TextView
                android:id="@+id/widget_hijri_date"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="end"
                android:maxLines="1"
                android:textColor="@color/widget_prayer_text_secondary"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- 五番时间行 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="4dp"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/widget_cell_0"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingTop="2dp"
                android:paddingBottom="2dp">

                <TextView
                    android:id="@+id/widget_name_0"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:text="@string/FAJR"
                    android:textColor="@color/widget_prayer_text_secondary"
                    android:textSize="10sp" />

                <TextView
                    android:id="@+id/widget_time_0"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:text="@string/widget_time_placeholder"
                    android:textColor="@color/widget_prayer_text_primary"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/widget_cell_1"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingTop="2dp"
                android:paddingBottom="2dp">

                <TextView
                    android:id="@+id/widget_name_1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:text="@string/DHOHR"
                    android:textColor="@color/widget_prayer_text_secondary"
                    android:textSize="10sp" />

                <TextView
                    android:id="@+id/widget_time_1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:text="@string/widget_time_placeholder"
                    android:textColor="@color/widget_prayer_text_primary"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/widget_cell_2"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingTop="2dp"
                android:paddingBottom="2dp">

                <TextView
                    android:id="@+id/widget_name_2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:text="@string/ASR"
                    android:textColor="@color/widget_prayer_text_secondary"
                    android:textSize="10sp" />

                <TextView
                    android:id="@+id/widget_time_2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:text="@string/widget_time_placeholder"
                    android:textColor="@color/widget_prayer_text_primary"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/widget_cell_3"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingTop="2dp"
                android:paddingBottom="2dp">

                <TextView
                    android:id="@+id/widget_name_3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:text="@string/MAGHRIB"
                    android:textColor="@color/widget_prayer_text_secondary"
                    android:textSize="10sp" />

                <TextView
                    android:id="@+id/widget_time_3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:text="@string/widget_time_placeholder"
                    android:textColor="@color/widget_prayer_text_primary"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/widget_cell_4"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingTop="2dp"
                android:paddingBottom="2dp">

                <TextView
                    android:id="@+id/widget_name_4"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:text="@string/ICHA"
                    android:textColor="@color/widget_prayer_text_secondary"
                    android:textSize="10sp" />

                <TextView
                    android:id="@+id/widget_time_4"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:text="@string/widget_time_placeholder"
                    android:textColor="@color/widget_prayer_text_primary"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
