<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <!-- 背景渐变 -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_subscription_gradient" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="16dp">

            <!-- 顶部清真寺剪影（放在 ScrollView 内部，不遮挡内容） -->
            <ImageView
                android:id="@+id/iv_mosque_silhouette"
                android:layout_width="0dp"
                android:layout_height="380dp"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_junaid"
                android:alpha="0.7"
                android:contentDescription="@string/app_name"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- 关闭按钮（在头图上方） -->
            <ImageView
                android:id="@+id/btn_close"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_margin="8dp"
                android:padding="12dp"
                android:src="@drawable/dr_icon_close"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/strLabelClose"
                app:tint="@android:color/white"
                android:elevation="8dp"
                app:layout_constraintTop_toTopOf="@id/iv_mosque_silhouette"
                app:layout_constraintStart_toStartOf="parent" />

        <!-- 主标题（在头图上方） -->
        <TextView
            android:id="@+id/title_container"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="48dp"
            android:layout_marginStart="32dp"
            android:layout_marginEnd="32dp"
            android:text="@string/subscription_heading"
            android:textColor="#FFD54F"
            android:textSize="28sp"
            android:textStyle="bold"
            android:gravity="center"
            android:lineSpacingExtra="2dp"
            android:fontFamily="sans-serif-medium"
            android:elevation="8dp"
            app:layout_constraintTop_toTopOf="@id/iv_mosque_silhouette"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- 功能列表 - 左对齐（在头图上方） -->
        <LinearLayout
            android:id="@+id/features_list"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_marginStart="40dp"
            android:layout_marginEnd="40dp"
            android:orientation="vertical"
            android:gravity="start"
            android:elevation="8dp"
            app:layout_constraintTop_toBottomOf="@id/title_container"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <!-- AI-Powered Learning Paths -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="16dp">

                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:src="@drawable/ic_brain"
                    app:tint="@android:color/white"
                    android:contentDescription="@null" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:text="@string/subscription_feature_ai"
                    android:textColor="@android:color/white"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:shadowColor="#80000000"
                    android:shadowDx="2"
                    android:shadowDy="2"
                    android:shadowRadius="4" />
            </LinearLayout>

            <!-- Ad-Free Devotion -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="16dp">

                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:src="@drawable/ic_no_ads"
                    app:tint="@android:color/white"
                    android:contentDescription="@null" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:text="@string/subscription_feature_ad_free"
                    android:textColor="@android:color/white"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:shadowColor="#80000000"
                    android:shadowDx="2"
                    android:shadowDy="2"
                    android:shadowRadius="4" />
            </LinearLayout>

            <!-- Deep Tafsir & Context -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="16dp">

                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:src="@drawable/ic_books"
                    app:tint="@android:color/white"
                    android:contentDescription="@null" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:text="@string/subscription_feature_tafsir"
                    android:textColor="@android:color/white"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:shadowColor="#80000000"
                    android:shadowDx="2"
                    android:shadowDy="2"
                    android:shadowRadius="4" />
            </LinearLayout>

            <!-- Full Quiz Library -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:src="@drawable/ic_star_flash"
                    app:tint="@android:color/white"
                    android:contentDescription="@null" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:text="@string/subscription_feature_quiz"
                    android:textColor="@android:color/white"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:shadowColor="#80000000"
                    android:shadowDx="2"
                    android:shadowDy="2"
                    android:shadowRadius="4" />
            </LinearLayout>
        </LinearLayout>

        <!-- 免费试用开关 - 透明度15%（在头图下方） -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/free_trial_card"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_marginStart="24dp"
            android:layout_marginEnd="24dp"
            android:background="@drawable/bg_subscription_card_transparent"
            android:padding="16dp"
            android:alpha="0.85"
            app:layout_constraintTop_toBottomOf="@id/iv_mosque_silhouette"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <TextView
                android:id="@+id/tv_free_trial_label"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/subscription_enable_trial"
                android:textColor="@android:color/white"
                android:textSize="16sp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toStartOf="@id/switch_free_trial" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/switch_free_trial"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="false"
                app:thumbTint="@color/switch_thumb_color"
                app:trackTint="@color/switch_track_color"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- 年度套餐 - 透明度15% -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/card_yearly_plan"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:minHeight="92dp"
            android:layout_marginTop="18dp"
            android:layout_marginStart="24dp"
            android:layout_marginEnd="24dp"
            android:background="@drawable/bg_subscription_card_transparent"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:alpha="0.85"
            app:layout_constraintTop_toBottomOf="@id/free_trial_card"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <RadioButton
                android:id="@+id/radio_yearly"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:button="@drawable/selector_radio_button"
                android:buttonTint="@android:color/white"
                android:checked="true"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="10dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toEndOf="@id/radio_yearly"
                app:layout_constraintEnd_toStartOf="@id/yearly_price_col">

                <TextView
                    android:id="@+id/tv_yearly_main_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/subscription_annual_plan_label"
                    android:textColor="#E6EFE9"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <!-- 真实年费全额：加大加粗醒目 -->
                <TextView
                    android:id="@+id/tv_yearly_sub_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textColor="#FFFFFF"
                    android:textSize="19sp"
                    android:textStyle="bold"
                    android:singleLine="true"
                    android:layout_marginTop="2dp"
                    tools:text="HK$78.00/year" />

                <!-- 「随时取消」独立成行，避免折行 -->
                <TextView
                    android:id="@+id/tv_yearly_cancel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/subscription_cancel_anytime"
                    android:textColor="#CFE0D5"
                    android:textSize="13sp"
                    android:layout_marginTop="2dp" />
            </LinearLayout>

            <!-- 右侧每月单价：年费拆算到每月（对比锚点），真实年费在左侧完整展示 -->
            <LinearLayout
                android:id="@+id/yearly_price_col"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="end"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <TextView
                    android:id="@+id/tv_yearly_permonth"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textColor="#FFD54F"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:gravity="end"
                    tools:text="HK$6.50" />

                <TextView
                    android:id="@+id/tv_yearly_permonth_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/subscription_per_month"
                    android:textColor="#E6EFE9"
                    android:textSize="12sp"
                    android:gravity="end" />
            </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Best Value 标签：骑在年卡上边框（半悬于边框之上），不占卡内高度 -->
        <TextView
            android:id="@+id/tv_best_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/subscription_best_value"
            android:textColor="#1A1A1A"
            android:textSize="13sp"
            android:textStyle="bold"
            android:background="@drawable/bg_best_value_badge"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="5dp"
            android:paddingBottom="5dp"
            android:elevation="10dp"
            app:layout_constraintTop_toTopOf="@id/card_yearly_plan"
            app:layout_constraintBottom_toTopOf="@id/card_yearly_plan"
            app:layout_constraintEnd_toEndOf="@id/card_yearly_plan"
            android:layout_marginEnd="16dp" />

        <!-- 月度套餐 - 透明度15% -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/card_monthly_plan"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:minHeight="92dp"
            android:layout_marginTop="12dp"
            android:layout_marginStart="24dp"
            android:layout_marginEnd="24dp"
            android:background="@drawable/bg_subscription_card_transparent"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:alpha="0.85"
            app:layout_constraintTop_toBottomOf="@id/card_yearly_plan"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <RadioButton
                android:id="@+id/radio_monthly"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:button="@drawable/selector_radio_button"
                android:buttonTint="@android:color/white"
                android:checked="false"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="10dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toEndOf="@id/radio_monthly"
                app:layout_constraintEnd_toStartOf="@id/monthly_price_col">

                <TextView
                    android:id="@+id/tv_monthly_main_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/subscription_monthly_plan_label"
                    android:textColor="@android:color/white"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_monthly_sub_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:layout_marginTop="4dp" />
            </LinearLayout>

            <!-- 右侧每月单价：月订阅本身即每月真实价，与年费每月单价同单位直接对比 -->
            <LinearLayout
                android:id="@+id/monthly_price_col"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="end"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <TextView
                    android:id="@+id/tv_monthly_permonth"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textColor="@android:color/white"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:gravity="end"
                    tools:text="HK$23.00" />

                <TextView
                    android:id="@+id/tv_monthly_permonth_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/subscription_per_month"
                    android:textColor="#E6EFE9"
                    android:textSize="12sp"
                    android:gravity="end" />
            </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- 套餐说明文本 - 动态变化 -->
        <TextView
            android:id="@+id/tv_subscription_info"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_marginStart="32dp"
            android:layout_marginEnd="32dp"
            android:text="@string/subscription_info_trial_monthly"
            android:textColor="@android:color/white"
            android:textSize="13sp"
            android:gravity="center"
            app:layout_constraintTop_toBottomOf="@id/card_monthly_plan"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- CTA 按钮 -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_subscribe"
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:layout_marginTop="28dp"
            android:layout_marginStart="24dp"
            android:layout_marginEnd="24dp"
            android:text="@string/subscription_cta_trial"
            android:textColor="@android:color/black"
            android:textSize="17sp"
            android:textStyle="bold"
            android:background="@drawable/bg_subscription_button"
            app:backgroundTint="@null"
            app:cornerRadius="30dp"
            android:elevation="6dp"
            android:stateListAnimator="@null"
            android:translationZ="4dp"
            app:layout_constraintTop_toBottomOf="@id/tv_subscription_info"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- NO PAYMENT NOW 提示 -->
        <LinearLayout
            android:id="@+id/no_payment_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:visibility="visible"
            app:layout_constraintTop_toBottomOf="@id/btn_subscribe"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_check_circle"
                android:contentDescription="@null" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="@string/subscription_no_payment_now"
                android:textColor="@android:color/white"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- 法律信息 -->
        <TextView
            android:id="@+id/tv_legal_info"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginStart="32dp"
            android:layout_marginEnd="32dp"
            android:text="@string/subscription_disclosure"
            android:textColor="#ECECEC"
            android:textSize="12sp"
            android:gravity="center"
            app:layout_constraintTop_toBottomOf="@id/no_payment_container"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <TextView
            android:id="@+id/tv_legal_links"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginStart="32dp"
            android:layout_marginEnd="32dp"
            android:layout_marginBottom="12dp"
            android:text="@string/subscription_legal_links"
            android:textColor="#F3D680"
            android:textSize="12sp"
            android:textStyle="bold"
            android:gravity="center"
            app:layout_constraintTop_toBottomOf="@id/tv_legal_info"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </ScrollView>

</FrameLayout>
